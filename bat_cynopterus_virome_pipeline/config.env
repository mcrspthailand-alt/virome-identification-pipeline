# Cynopterus bat pooled samples virome pipeline configuration.

# Project output directory. The pipeline writes logs/, samples/, merged/, taxonomy/ here.
OUT_BASE="/home/panda/workspace/projects/nextflow_metagenomic/PANDA/bat/results_Cynopterus/viral_id_pipeline"

# Sample sheet. Columns: sample, assembly, r1, r2
SAMPLES_TSV="./samples.tsv"

# Compute parameters
THREADS=32
MIN_CONTIG_LEN=500
DEPTH_CUTOFF=2
VS2_MIN_LEN=500

# DIAMOND viral protein database
DIAMOND_DB="/home/panda/workspace/databases/diamond/virus_nr/virus_nr.dmnd"

# Tool databases
GENOMAD_DB="/home/panda/workspace/databases/genomad/genomad_db"
VS2_DB_DIR="/home/panda/workspace/databases/virsorter2_db"
CHECKV_DB="/home/panda/workspace/databases/checkv_db/checkv-db-v1.5"

# NCBI taxonomy. If nodes.dmp and names.dmp already exist in TAXONOMY_DIR,
# the taxonomy step will use them. Otherwise it will download taxdump.tar.gz.
TAXONOMY_DIR="${OUT_BASE}/taxonomy"
TAXDUMP_URL="https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz"

# Homology thresholds used to call blastx_hit and blastp_hit.
DIAMOND_EVALUE="1e-10"
DIAMOND_BITSCORE=100
DIAMOND_ALNLEN=60
DIAMOND_MAX_TARGET_SEQS=5
